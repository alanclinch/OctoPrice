# ---------------------------------------------------------------------------
# OctoPrice environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Data access -----------------------------------------------------------------
# sqlite: file path. postgres: standard connection URL (future).
DATABASE_URL=file:./data/octoprice.sqlite

# Server ----------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Octopus Energy --------------------------------------------------------------
# Public price endpoints need no credentials. These are optional and only used
# by the (future) automatic tariff detection feature.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# Default Agile region (single-letter DNO code A-P, no I or O).
# Used only as the initial default before the user chooses one in Settings.
DEFAULT_REGION=C

# Web Push (VAPID) ------------------------------------------------------------
# Generate with: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler -------------------------------------------------------------------
# Times are Europe/London. Polling starts at START, retries every INTERVAL
# minutes until CUTOFF or a complete dataset is retrieved.
POLL_START=16:05
POLL_INTERVAL_MINUTES=5
POLL_CUTOFF=22:15
