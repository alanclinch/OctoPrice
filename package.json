{
  "name": "octoprice",
  "version": "0.1.0",
  "private": true,
  "description": "Octopus Agile price monitoring and notification PWA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanclinch/OctoPrice.git"
  },
  "bugs": {
    "url": "https://github.com/alanclinch/OctoPrice/issues"
  },
  "homepage": "https://github.com/alanclinch/OctoPrice#readme",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run dev --workspace @octoprice/server",
    "dev:web": "npm run dev --workspace @octoprice/web",
    "generate:vapid": "node apps/server/src/scripts/generate-vapid.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
